{
  "multipart": [
    {"apply": {"model": "minecraft:block/pale_oak_fence_post"}},
    {
      "apply": {
        "type": "polytone:expression",
        "fabric:type": "polytone:expression",
        "cases": [
          {
            "when": "o.north().hasBlockTag('minecraft:fences') || o.north().hasBlockTag('minecraft:fence_gates')",
            "model": {
              "model": "minecraft:block/pale_oak_fence_side",
              "uvlock": true
            }
          }
        ],
        "fallback": {"model": "minecraft:block/air", "uvlock": true},
        "model": "minecraft:block/pale_oak_fence_side",
        "uvlock": true
      },
      "when": {"north": true}
    },
    {
      "apply": {
        "type": "polytone:expression",
        "fabric:type": "polytone:expression",
        "cases": [
          {
            "when": "o.east().hasBlockTag('minecraft:fences') || o.east().hasBlockTag('minecraft:fence_gates')",
            "model": {
              "model": "minecraft:block/pale_oak_fence_side",
              "uvlock": true,
              "y": 90
            }
          }
        ],
        "fallback": {"model": "minecraft:block/air", "uvlock": true, "y": 90},
        "model": "minecraft:block/pale_oak_fence_side",
        "uvlock": true,
        "y": 90
      },
      "when": {"east": true}
    },
    {
      "apply": {
        "type": "polytone:expression",
        "fabric:type": "polytone:expression",
        "cases": [
          {
            "when": "o.south().hasBlockTag('minecraft:fences') || o.south().hasBlockTag('minecraft:fence_gates')",
            "model": {
              "model": "minecraft:block/pale_oak_fence_side",
              "uvlock": true,
              "y": 180
            }
          }
        ],
        "fallback": {"model": "minecraft:block/air", "uvlock": true, "y": 180},
        "model": "minecraft:block/pale_oak_fence_side",
        "uvlock": true,
        "y": 180
      },
      "when": {"south": true}
    },
    {
      "apply": {
        "type": "polytone:expression",
        "fabric:type": "polytone:expression",
        "cases": [
          {
            "when": "o.west().hasBlockTag('minecraft:fences') || o.west().hasBlockTag('minecraft:fence_gates')",
            "model": {
              "model": "minecraft:block/pale_oak_fence_side",
              "uvlock": true,
              "y": 270
            }
          }
        ],
        "fallback": {"model": "minecraft:block/air", "uvlock": true, "y": 270},
        "model": "minecraft:block/pale_oak_fence_side",
        "uvlock": true,
        "y": 270
      },
      "when": {"west": true}
    }
  ]
}