{
  "targets": {"swap": {}},
  "passes": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "golden_days:post/outlines",
      "inputs": [
        {"sampler_name": "In", "target": "minecraft:main"},
        {
          "sampler_name": "Depth",
          "target": "minecraft:main",
          "use_depth_buffer": true,
          "bilinear": true
        }
      ],
      "output": "swap",
      "uniforms": {
        "OutlineConfig": [
          {"name": "OutlineDarkness", "type": "float", "value": 0.75},
          {"name": "OutlineThickness", "type": "float", "value": 1.0}
        ]
      }
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/blit",
      "inputs": [{"sampler_name": "In", "target": "swap"}],
      "uniforms": {
        "BlitConfig": [
          {
            "name": "ColorModulate",
            "type": "vec4",
            "value": [1.0, 1.0, 1.0, 1.0]
          }
        ]
      },
      "output": "minecraft:main"
    }
  ]
}