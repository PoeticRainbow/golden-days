{
  "render_type": "translucent",
  "random_sprite": true,
  "kill_when_still": false,
  "liquid_affinity": "non_liquids",
  "rotation_mode": {"y_rot": "atan2(p.x()-o.x(),p.z()-o.z())"},
  "initializer": {"lifetime": "20+r.rand()*60", "alpha": "0", "size": "1.25"},
  "ticker": {
    "alpha": "sin(PI*(o.age()/o.life()))*max(1-(abs(p.y()-o.y())/8),0)"
  }
}